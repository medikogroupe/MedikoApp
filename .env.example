# Base de données PostgreSQL (déploiement Docker / Contabo VPS)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Sécurité des sessions étudiantes (HMAC cookie)
SESSION_SECRET=changez-cette-cle-secrete

# Accès à la console /admin
ADMIN_PASSWORD=medikoplus2026

# Variantes Supabase (si vous branchez l'app sur Supabase plutôt que Postgres auto-hébergé)
