+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { FileSpreadsheet, ImagePlus, Loader2, Pencil, Plus, Save, Trash2, X } from "lucide-react";
+import { MATIERES } from "@/lib/constants";
+import { TYPES_QUESTION } from "@/lib/qcm";
+
+type Question = {
+  id: string;
+  matiere: string;
+  question: string;
+  propositions: string[];
+  propositionsImages: (string | null)[];
+  bonnes: number[];
+  bonneReponse: string;
+  type: string;
+  points: number;
+  penalite: number;
+  mode: string;
+  explication: string;
+  niveau: string;
+  imageId: string | null;
+  actif: boolean;
+};
+
+type Formulaire = {
+  id: string;
+  matiere: string;
+  niveau: string;
+  type: string;
+  question: string;
+  imageId: string | null;
+  lignes: { texte: string; image: string | null; bonne: boolean }[];
+  points: string;
+  penalite: string;
+  mode: string;
+  explication: string;
+  actif: boolean;
+};
+
+const NIVEAUX = ["L1", "L2", "L3", "M1", "M2"];
+
+function vide(): Formulaire {
+  return {
+    id: "",
+    matiere: MATIERES[0],
+    niveau: "L1",
+    type: "QCU",
+    question: "",
+    imageId: null,
+    lignes: [0, 1, 2, 3].map(() => ({ texte: "", image: null, bonne: false })),
+    points: "1",
+    penalite: "0",
+    mode: "TOUT_OU_RIEN",
+    explication: "",
+    actif: true,
+  };
+}
+
+function depuis(q: Question): Formulaire {
+  const bonnes = q.bonnes.length > 0 ? q.bonnes : [q.propositions.indexOf(q.bonneReponse)];
+  return {
+    id: q.id,
